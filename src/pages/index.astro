---
import DualPortfolio from "../components/directions/DualPortfolio.astro";
const canonical = new URL("/", Astro.site ?? "https://kangnam7654.github.io").href;
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="index,follow" />
  <meta name="theme-color" content="#f4b9d2" />
  <meta name="description" content="AI 엔지니어 김강남의 작업. 언리얼 엔진 도구, 영어 발표 평가 모델과 추론 파이프라인, 글쓰기 도구와 앱을 소개합니다." />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="data:," />
  <link rel="preload" href="/fonts/art-directions/bricolage-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/art-directions/black-han-name.woff2" as="font" type="font/woff2" crossorigin />
  <title>김강남 — AI 엔지니어 · 작업과 도구</title>
</head>
<body data-study="type" data-ab-variant="type" data-ab-entry="true">
  <DualPortfolio variant="type" />
  <script>import "../lib/portfolio-ab";</script>
</body>
</html>
