---
import DualPortfolio from "../../components/directions/DualPortfolio.astro";
import { portfolioVariants, type PortfolioVariant } from "../../data/dual-portfolio";

export function getStaticPaths() {
  return portfolioVariants.map((variant) => ({ params: { variant }, props: { variant } }));
}
interface Props { variant: PortfolioVariant }
const { variant } = Astro.props;
const canonical = new URL("/", Astro.site ?? "https://kangnam7654.github.io").href;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="index,follow" />
    <meta name="theme-color" content={variant === "type" ? "#f4b9d2" : "#253fc4"} />
    <meta name="description" content="AI 엔지니어 김강남의 작업. 언리얼 엔진 MCP 프로토타입 모듈, 영어 발표 평가 모델과 추론 파이프라인, 개인적으로 만드는 글쓰기 도구와 앱을 소개합니다." />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="data:," />
    <link rel="preload" href="/fonts/art-directions/bricolage-latin.woff2" as="font" type="font/woff2" crossorigin />
    {variant === "type" && <link rel="preload" href="/fonts/art-directions/black-han-name.woff2" as="font" type="font/woff2" crossorigin />}
    <title>김강남 — AI 엔지니어 · 작업과 도구</title>
  </head>
  <body data-study={variant} data-ab-variant={variant}>
    <DualPortfolio variant={variant} />
  </body>
</html>
